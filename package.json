{
  "name": "quorum",
  "version": "0.1.0",
  "description": "Presentations, but interactive. Agent ready. Write your talk in Markdown (or let your coding agent write it), people vote, guess and ask from their phones, and everything runs from your laptop.",
  "type": "module",
  "bin": {
    "quorum": "bin/quorum.js"
  },
  "files": [
    "bin",
    "src",
    "app",
    "templates",
    "examples",
    "docs/*.md",
    "agents",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:e2e": "node test/e2e/run.js && node test/e2e/site.js && node test/e2e/export.js",
    "demo": "node bin/quorum.js preview examples/demo",
    "build:site": "node scripts/build-site.js"
  },
  "keywords": [
    "presentation",
    "slides",
    "markdown",
    "audience",
    "interactive",
    "poll",
    "live",
    "qr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JBoixCampos/quorum.git"
  },
  "homepage": "https://jboixcampos.github.io/quorum/"
}
